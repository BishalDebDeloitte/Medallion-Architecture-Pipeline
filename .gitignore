# Secrets: never commit real keys (the template .env.example is tracked)
.env
.env.*
!.env.example

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Editor, assistant and OS files
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Everything the app generates at run time: uploads, profiles, mappings, Parquet layers,
# reports, traces, saved runs, audit logs and the memory database
/data/
/audit_logs/
/.chroma/
*.parquet

# Test and notebook leftovers
.pytest_cache/
**/.ipynb_checkpoints/
