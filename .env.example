# Copy this file to .env and fill in only the key for the provider you select.
# Never commit .env or real keys; this template contains no secrets.
# Supported providers: anthropic (default, recommended), groq, gemini, openai, github
LLM_PROVIDER=anthropic

# Required for anthropic. Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# A dated snapshot avoids unintended model changes. Model list: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Required for groq. Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Keep comments on their own line: python-dotenv treats " #" after a value as part of a comment.
# The gpt-oss models return reasoning text; check the reply parsing before relying on them.
GROQ_MODEL=openai/gpt-oss-20b

# Required for gemini. Get a key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required for openai. Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required for github (GitHub Models). Give the token only the permissions GitHub Models needs.
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini
